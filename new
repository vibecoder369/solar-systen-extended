                nasa: "https://solarsystem.nasa.gov/planets/uranus/in-depth/",
                size: 3.0,
                distanceFromSun: 92,
                speed: 0.006,
                color: 0x22d3ee
            },
            neptune: {
                name: "Neptune",
                subtitle: "Ice Giant",
                desc: "Dark, cold, and whipped by supersonic winds, ice giant Neptune is the most distant major planet in our solar system.",
                diameter: "49,244 km",
                distance: "4.50B km",
                day: "16.1 hours",
                year: "165 Earth years",
                fact: "Neptune was the first planet located through mathematical calculations rather than via telescope.",
                nasa: "https://solarsystem.nasa.gov/planets/neptune/in-depth/",
                size: 2.9,
                distanceFromSun: 108,
                speed: 0.004,
                color: 0x2563eb
            }
        };

        // Procedural Texture Generator Helpers
        function createPlanetTexture(type, baseColorHex) {
            const canvas = document.createElement('canvas');
            canvas.width = 1024;
            canvas.height = 512;
            const ctx = canvas.getContext('2d');

            ctx.fillStyle = baseColorHex;
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Add procedural details based on type
            if (type === 'sun') {
                const grad = ctx.createRadialGradient(512, 256, 10, 512, 256, 500);
                grad.addColorStop(0, '#fffbeb');
                grad.addColorStop(0.5, '#f59e0b');
                grad.addColorStop(1, '#b45309');
                ctx.fillStyle = grad;
                ctx.fillRect(0, 0, canvas.width, canvas.height);
                for (let i = 0; i < 500; i++) {
                    ctx.fillStyle = Math.random() > 0.5 ? 'rgba(255,255,255,0.2)' : 'rgba(120,53,15,0.3)';
                    ctx.beginPath();
                    ctx.arc(Math.random() * canvas.width, Math.random() * canvas.height, Math.random() * 20 + 2, 0, Math.PI * 2);
                    ctx.fill();
                }
            } else if (type === 'jupiter') {
                ctx.fillStyle = '#b45309';
                for (let i = 0; i < 30; i++) {
                    ctx.fillRect(0, Math.random() * canvas.height, canvas.width, Math.random() * 20 + 5);
                }
                // Great Red Spot
                ctx.fillStyle = '#dc2626';
                ctx.beginPath();
                ctx.ellipse(700, 350, 60, 35, 0, 0, Math.PI * 2);
                ctx.fill();
            } else if (type === 'earth') {
                // Continents green/brown
                ctx.fillStyle = '#166534';
                for (let i = 0; i < 40; i++) {
                    ctx.beginPath();
                    ctx.arc(Math.random() * canvas.width, Math.random() * canvas.height, Math.random() * 80 + 20, 0, Math.PI * 2);
                    ctx.fill();
                }
                // Clouds white
                ctx.fillStyle = 'rgba(255, 255, 255, 0.4)';
                for (let i = 0; i < 25; i++) {
                    ctx.beginPath();
                    ctx.arc(Math.random() * canvas.width, Math.random() * canvas.height, Math.random() * 60 + 10, 0, Math.PI * 2);
                    ctx.fill();
                }
            } else if (type === 'gas') {
                ctx.fillStyle = 'rgba(0, 0, 0, 0.2)';
                for (let i = 0; i < 20; i++) {
                    ctx.fillRect(0, Math.random() * canvas.height, canvas.width, Math.random() * 30 + 10);
                }
            } else {
                // Rocky craters / noise
                ctx.fillStyle = 'rgba(0, 0, 0, 0.25)';
                for (let i = 0; i < 300; i++) {
                    ctx.beginPath();
                    ctx.arc(Math.random() * canvas.width, Math.random() * canvas.height, Math.random() * 10 + 1, 0, Math.PI * 2);
                    ctx.fill();
                }
            }

            const texture = new THREE.CanvasTexture(canvas);
            texture.wrapS = THREE.RepeatWrapping;
            texture.wrapT = THREE.ClampToEdgeWrapping;
            return texture;
        }

        // Three.js Core Setup
        let scene, camera, renderer, clock;
        let planetMeshes = {};
        let orbitLines = [];
        let raycaster, mouse;
        let selectedPlanetKey = null;
        let isTransitioning = false;
        let transitionProgress = 1;
        let camStartPos = new THREE.Vector3();
        let camTargetPos = new THREE.Vector3();
        let controlsSpeedMultiplier = 1.0;
        let orbitsVisible = true;
        let rotationEnabled = true;

        // Discovery Log Store
        let discoveryLog = JSON.parse(localStorage.getItem('solar_discovery_log') || '[]');

        function init() {
            const container = document.getElementById('canvas-container');

            // Scene & Camera
            scene = new THREE.Scene();
            scene.fog = new THREE.FogExp2(0x020617, 0.0015);

            camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 2000);
            camera.position.set(0, 50, 120);

            // Renderer
            renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            renderer.shadowMap.enabled = true;
            renderer.shadowMap.type = THREE.PCFSoftShadowMap;
            renderer.xr.enabled = true;
            container.appendChild(renderer.domElement);

            // VR Button Integration
            document.getElementById('vr-button-container').appendChild(THREEx.VRButton.createButton(renderer));

            clock = new THREE.Clock();
            raycaster = new THREE.Raycaster();
            mouse = new THREE.Vector2();

            // Lighting
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.3);
            scene.add(ambientLight);

            const sunLight = new THREE.PointLight(0xffffff, 2.5, 1000, 0.5);
            sunLight.position.set(0, 0, 0);
            sunLight.castShadow = true;
            sunLight.shadow.mapSize.width = 2048;
            sunLight.shadow.mapSize.height = 2048;
            scene.add(sunLight);

            // Starfield Background
            createStarfield();

            // Build Solar System
            buildSolarSystem();

            // Event Listeners
            window.addEventListener('resize', onWindowResize, false);
            window.addEventListener('click', onDocumentClick, false);

            setupUIInteractions();
            updateLogBadge();

            // Start animation loop using WebXR setAnimationLoop
            renderer.setAnimationLoop(animate);
        }

        function createStarfield() {
            const starsGeometry = new THREE.BufferGeometry();
            const starsCount = 3000;
            const positions = new Float32Array(starsCount * 3);

            for (let i = 0; i < starsCount * 3; i += 3) {
                positions[i] = (Math.random() - 0.5) * 1000;
                positions[i + 1] = (Math.random() - 0.5) * 1000;
                positions[i + 2] = (Math.random() - 0.5) * 1000;
            }

            starsGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
            const starsMaterial = new THREE.PointsMaterial({
                color: 0xffffff,
                size: 1.2,
                transparent: true,
                opacity: 0.8
            });
            const starField = new THREE.Points(starsGeometry, starsMaterial);
            scene.add(starField);
        }

        function buildSolarSystem() {
            const sphereGeo = new THREE.SphereGeometry(1, 64, 64);

            for (const [key, data] of Object.entries(planetsData)) {
                const group = new THREE.Group();

                let material;
                if (key === 'sun') {
                    const sunTex = createPlanetTexture('sun', '#f59e0b');
                    material = new THREE.MeshBasicMaterial({ map: sunTex });
                } else if (key === 'jupiter') {
                    const jupTex = createPlanetTexture('jupiter', '#d97706');
                    material = new THREE.MeshStandardMaterial({ map: jupTex, roughness: 0.8 });
                } else if (key === 'earth') {
                    const earthTex = createPlanetTexture('earth', '#38bdf8');
                    material = new THREE.MeshStandardMaterial({ map: earthTex, roughness: 0.6, metalness: 0.1 });
                } else {
                    const tex = createPlanetTexture('gas', data.color);
                    material = new THREE.MeshStandardMaterial({ map: tex, roughness: 0.7, color: data.color });
                }

                const mesh = new THREE.Mesh(sphereGeo, material);
                mesh.scale.setScalar(data.size);
                mesh.castShadow = key !== 'sun';
                mesh.receiveShadow = key !== 'sun';
                group.add(mesh);

                // Sun Glow
                if (key === 'sun') {
                    const glowGeo = new THREE.SphereGeometry(data.size * 1.15, 32, 32);
                    const glowMat = new THREE.MeshBasicMaterial({
                        color: 0xf59e0b,
                        transparent: true,
                        opacity: 0.35,
                        side: THREE.BackSide
                    });
                    const glowMesh = new THREE.Mesh(glowGeo, glowMat);
                    group.add(glowMesh);
                }

                // Saturn Rings
                if (data.hasRings) {
                    const ringGeo = new THREE.RingGeometry(data.size * 1.4, data.size * 2.3, 64);
                    // Rotate ring to horizontal plane
                    ringGeo.rotateX(Math.PI / 2);
                    const ringMat = new THREE.MeshStandardMaterial({
                        color: 0xd4d4d8,
                        side: THREE.DoubleSide,
                        transparent: true,
                        opacity: 0.8,
                        roughness: 0.5
                    });
                    const ringMesh = new THREE.Mesh(ringGeo, ringMat);
                    ringMesh.castShadow = true;
                    ringMesh.receiveShadow = true;
                    group.add(ringMesh);
                }

                // Earth Moon
                if (data.hasMoon) {
                    const moonGeo = new THREE.SphereGeometry(0.5, 32, 32);
                    const moonMat = new THREE.MeshStandardMaterial({ color: 0x94a3b8, roughness: 0.9 });
                    const moonMesh = new THREE.Mesh(moonGeo, moonMat);
                    moonMesh.name = 'moon';
                    group.add(moonMesh);
                }

                scene.add(group);

                // Create Orbit Line
                if (data.distanceFromSun > 0) {
                    const orbitGeo = new THREE.BufferGeometry();
                    const points = [];
                    const segments = 128;
                    for (let i = 0; i <= segments; i++) {
                        const theta = (i / segments) * Math.PI * 2;
                        points.push(new THREE.Vector3(Math.cos(theta) * data.distanceFromSun, 0, Math.sin(theta) * data.distanceFromSun));
                    }
                    orbitGeo.setFromPoints(points);
                    const orbitMat = new THREE.LineBasicMaterial({ color: 0x38bdf8, transparent: true, opacity: 0.15 });
                    const orbitLine = new THREE.Line(orbitGeo, orbitMat);
                    scene.add(orbitLine);
                    orbitLines.push(orbitLine);
                }

                planetMeshes[key] = {
                    group: group,
                    mesh: mesh,
                    data: data,
                    angle: Math.random() * Math.PI * 2
                };
            }
        }

        // Animation Loop
        function animate() {
            const delta = clock.getDelta();
            const elapsedTime = clock.getElapsedTime();

            // Update planet positions and rotations
            for (const [key, planet] of Object.entries(planetMeshes)) {
                if (planet.data.distanceFromSun > 0) {
                    planet.angle += planet.data.speed * delta * controlsSpeedMultiplier;
                    const x = Math.cos(planet.angle) * planet.data.distanceFromSun;
                    const z = Math.sin(planet.angle) * planet.data.distanceFromSun;
                    planet.group.position.set(x, 0, z);
                }

                if (rotationEnabled) {
                    planet.mesh.rotation.y += delta * 0.5;
                }

                // Animate Moon around Earth
                if (key === 'earth') {
                    const moon = planet.group.getObjectByName('moon');
                    if (moon) {
                        const moonAngle = elapsedTime * 1.5;
                        moon.position.set(Math.cos(moonAngle) * 5, 0, Math.sin(moonAngle) * 5);
                    }
                }
            }

            // Handle Camera Smooth Transitions
            if (!isTransitioning && selectedPlanetKey && planetMeshes[selectedPlanetKey]) {
                const planetGroup = planetMeshes[selectedPlanetKey].group;
                const targetWorldPos = new THREE.Vector3();
                planetGroup.getWorldPosition(targetWorldPos);
                // Lock camera offset relative to moving planet
                const offset = new THREE.Vector3(0, planetMeshes[selectedPlanetKey].data.size * 3, planetMeshes[selectedPlanetKey].data.size * 6);
                camera.position.copy(targetWorldPos).add(offset);
                camera.lookAt(targetWorldPos);
            } else if (isTransitioning) {
                transitionProgress += delta * 1.2;
                if (transitionProgress >= 1) {
                    transitionProgress = 1;
                    isTransitioning = false;
                }
                camera.position.lerpVectors(camStartPos, camTargetPos, easeOutCubic(transitionProgress));
                if (selectedPlanetKey && planetMeshes[selectedPlanetKey]) {
                    const targetWorldPos = new THREE.Vector3();
                    planetMeshes[selectedPlanetKey].group.getWorldPosition(targetWorldPos);
                    camera.lookAt(targetWorldPos);
                } else {
                    camera.lookAt(0, 0, 0);
                }
            }

            renderer.render(scene, camera);
        }

        function easeOutCubic(x) {
            return 1 - Math.pow(1 - x, 3);
        }

        // Interaction & Raycasting
        function onDocumentClick(event) {
            // Ignore UI clicks
            if (event.target.closest('header') || event.target.closest('#planet-info-panel') || event.target.closest('.glass-panel') || event.target.closest('button')) {
                return;
            }

            mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
            mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;

            raycaster.setFromCamera(mouse, camera);
            const intersects = raycaster.intersectObjects(scene.children, true);

            for (let intersect of intersects) {
                // Find parent group that corresponds to a planet
                for (let [key, planet] of Object.entries(planetMeshes)) {
                    if (intersect.object === planet.mesh || planet.group.children.includes(intersect.object)) {
                        selectPlanet(key);
                        return;
                    }
                }
            }
        }

        function selectPlanet(key) {
            const data = planetsData[key];
            if (!data) return;

            selectedPlanetKey = key;
            isTransitioning = true;
            transitionProgress = 0;
            camStartPos.copy(camera.position);

            const planetWorldPos = new THREE.Vector3();
            planetMeshes[key].group.getWorldPosition(planetWorldPos);

            const offset = new THREE.Vector3(0, data.size * 3, data.size * 6);
            camTargetPos.copy(planetWorldPos).add(offset);

            // Populate Info Panel
            document.getElementById('planet-subtitle').textContent = data.subtitle;
            document.getElementById('planet-title').textContent = data.name;
            document.getElementById('planet-desc').textContent = data.desc;
            document.getElementById('planet-diameter').textContent = data.diameter;
            document.getElementById('planet-distance').textContent = data.distance;
            document.getElementById('planet-day').textContent = data.day;
            document.getElementById('planet-year').textContent = data.year;
            document.getElementById('planet-fact').textContent = data.fact;
            document.getElementById('nasa-link').href = data.nasa;

            const panel = document.getElementById('planet-info-panel');
            panel.classList.remove('translate-x-[120%]', 'opacity-0');
        }

        function resetCamera() {
            selectedPlanetKey = null;
            isTransitioning = true;
            transitionProgress = 0;
            camStartPos.copy(camera.position);
            camTargetPos.set(0, 50, 120);

            const panel = document.getElementById('planet-info-panel');
            panel.classList.add('translate-x-[120%]', 'opacity-0');
        }

        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        // UI & Features Setup
        function setupUIInteractions() {
            // Planet selector buttons
            document.querySelectorAll('.planet-nav-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const planetKey = btn.getAttribute('data-planet');
                    selectPlanet(planetKey);
                });
            });

            document.getElementById('btn-reset-cam').addEventListener('click', resetCamera);
            document.getElementById('btn-close-info').addEventListener('click', resetCamera);

            // Simulation Controls
            const speedRange = document.getElementById('range-speed');
            const speedVal = document.getElementById('speed-val');
            speedRange.addEventListener('input', (e) => {
                controlsSpeedMultiplier = parseFloat(e.target.value);
                speedVal.textContent = controlsSpeedMultiplier.toFixed(1) + 'x';
            });

            const toggleOrbits = document.getElementById('toggle-orbits');
            toggleOrbits.addEventListener('change', (e) => {
                orbitsVisible = e.target.checked;
                orbitLines.forEach(line => line.visible = orbitsVisible);
            });

            const toggleRotation = document.getElementById('toggle-rotation');
            toggleRotation.addEventListener('change', (e) => {
                rotationEnabled = e.target.checked;
            });

            // Discovery Log Collection
            document.getElementById('btn-collect-fact').addEventListener('click', () => {
                if (!selectedPlanetKey) return;
                const data = planetsData[selectedPlanetKey];
                const logItem = { key: selectedPlanetKey, name: data.name, fact: data.fact, date: new Date().toLocaleDateString() };
                
                if (!discoveryLog.some(item => item.key === selectedPlanetKey)) {
                    discoveryLog.push(logItem);
                    localStorage.setItem('solar_discovery_log', JSON.stringify(discoveryLog));
                    updateLogBadge();
                    showNotification(`Collected fact for ${data.name}!`);
                } else {
                    showNotification(`Already in your Discovery Log!`);
                }
            });

            // Guided Tour Logic
            const tourModal = document.getElementById('tour-modal');
            const tourSteps = [
                { key: 'sun', title: "The Sun: Our Star", text: "At the center of our solar system is the Sun, a G-type main-sequence star containing 99.8% of all mass." },
                { key: 'mercury', title: "Mercury: The Swift Planet", text: "Mercury is the smallest planet and closest to the Sun, experiencing extreme temperature swings." },
                { key: 'venus', title: "Venus: The Hottest World", text: "Venus features a runaway greenhouse effect making its surface hotter than Mercury's." },
                { key: 'earth', title: "Earth: Our Cradle", text: "The third planet from the Sun and the only known world harboring abundant life and liquid water." },
                { key: 'mars', title: "Mars: The Red Planet", text: "Mars holds ancient riverbeds, polar ice caps, and Olympus Mons, the solar system's tallest volcano." },
                { key: 'jupiter', title: "Jupiter: The Giant", text: "Jupiter is the colossal gas giant with dozens of moons and the famous Great Red Spot storm." },
                { key: 'saturn', title: "Saturn: The Ringed Jewel", text: "Saturn is famed for its majestic, extensive ring system composed mostly of ice particles." },
                { key: 'uranus', title: "Uranus: The Tilted Ice Giant", text: "Uranus rotates completely on its side, resulting in extreme 42-year long seasons." },
                { key: 'neptune', title: "Neptune: The Windy Blue World", text: "The farthest major planet, whipped by supersonic winds in its deep methane atmosphere." }
            ];
            let currentTourStep = 0;

            document.getElementById('btn-tour').addEventListener('click', () => {
                tourModal.classList.remove('hidden');
                tourModal.classList.add('flex');
                showTourStep(0);
            });
            document.getElementById('tour-close').addEventListener('click', () => {
                tourModal.classList.add('hidden');
                tourModal.classList.remove('flex');
                resetCamera();
            });

            function showTourStep(index) {
                currentTourStep = index;
                const step = tourSteps[index];
                document.getElementById('tour-step-counter').textContent = `Step ${index + 1} of ${tourSteps.length}: ${step.title.split(':')[0]}`;
                document.getElementById('tour-title').textContent = step.title;
                document.getElementById('tour-text').textContent = step.text;
                selectPlanet(step.key);

                // Update dots
                const dotsContainer = document.getElementById('tour-dots');
                dotsContainer.innerHTML = '';
                tourSteps.forEach((_, i) => {
                    const dot = document.createElement('div');
                    dot.className = `w-2 h-2 rounded-full ${i === index ? 'bg-cyan-400 w-4' : 'bg-slate-700'} transition-all`;
                    dotsContainer.appendChild(dot);
                });
            }

            document.getElementById('tour-next').addEventListener('click', () => {
                if (currentTourStep < tourSteps.length - 1) {
                    showTourStep(currentTourStep + 1);
                } else {
                    tourModal.classList.add('hidden');
                    tourModal.classList.remove('flex');
                    resetCamera();
                }
            });
            document.getElementById('tour-prev').addEventListener('click', () => {
                if (currentTourStep > 0) {
                    showTourStep(currentTourStep - 1);
                }
            });

            // Quiz Modal Logic
            const quizModal = document.getElementById('quiz-modal');
            const quizQuestions = [
                { q: "Which planet is closest to the Sun?", options: ["Venus", "Mercury", "Earth", "Mars"], answer: 1 },
                { q: "What is the largest planet in our solar system?", options: ["Saturn", "Jupiter", "Neptune", "Earth"], answer: 1 },
                { q: "Which planet is famous for its prominent ring system?", options: ["Uranus", "Jupiter", "Saturn", "Neptune"], answer: 2 },
                { q: "Which planet is known as the Red Planet?", options: ["Mars", "Venus", "Mercury", "Jupiter"], answer: 0 },
                { q: "What percentage of the solar system's mass does the Sun contain?", options: ["50%", "85%", "95%", "99.8%"], answer: 3 }
            ];
            let currentQuizIndex = 0;
            let quizScore = 0;

            document.getElementById('btn-quiz').addEventListener('click', () => {
                quizModal.classList.remove('hidden');
                quizModal.classList.add('flex');
                currentQuizIndex = 0;
                quizScore = 0;
                loadQuizQuestion();
            });
            document.getElementById('quiz-close').addEventListener('click', () => {
                quizModal.classList.add('hidden');
                quizModal.classList.remove('flex');
            });
            document.getElementById('quiz-restart').addEventListener('click', () => {
                currentQuizIndex = 0;
                quizScore = 0;
                document.getElementById('quiz-result-container').classList.add('hidden');
                document.getElementById('quiz-question-container').classList.remove('hidden');
                loadQuizQuestion();
            });

            function loadQuizQuestion() {
                const qData = quizQuestions[currentQuizIndex];
                document.getElementById('quiz-progress').textContent = `Question ${currentQuizIndex + 1} of ${quizQuestions.length}`;
                document.getElementById('quiz-question').textContent = qData.q;
                document.getElementById('quiz-current-score').textContent = quizScore;
                document.getElementById('quiz-next-btn').classList.add('hidden');

                const optionsContainer = document.getElementById('quiz-options');
                optionsContainer.innerHTML = '';
                qData.options.forEach((opt, idx) => {
                    const btn = document.createElement('button');
                    btn.className = 'w-full text-left p-3 rounded-xl glass-button text-xs font-semibold text-slate-200 transition-all';
                    btn.textContent = opt;
                    btn.addEventListener('click', () => {
                        // Disable all options
                        Array.from(optionsContainer.children).forEach(b => b.disabled = true);
                        if (idx === qData.answer) {
                            btn.classList.add('bg-emerald-500/30', 'border-emerald-400');
                            quizScore++;
                        } else {
                            btn.classList.add('bg-rose-500/30', 'border-rose-400');
                            optionsContainer.children[qData.answer].classList.add('bg-emerald-500/30', 'border-emerald-400');
                        }
                        document.getElementById('quiz-current-score').textContent = quizScore;
                        document.getElementById('quiz-next-btn').classList.remove('hidden');
                    });
                    optionsContainer.appendChild(btn);
                });
            }

            document.getElementById('quiz-next-btn').addEventListener('click', () => {
                currentQuizIndex++;
                if (currentQuizIndex < quizQuestions.length) {
                    loadQuizQuestion();
                } else {
                    document.getElementById('quiz-question-container').classList.add('hidden');
                    document.getElementById('quiz-footer').classList.add('hidden');
                    document.getElementById('quiz-result-container').classList.remove('hidden');
                    document.getElementById('quiz-score-text').textContent = `You scored ${quizScore} out of ${quizQuestions.length} correct answers!`;
                }
            });

            // Discovery Log Modal
            const logModal = document.getElementById('log-modal');
            document.getElementById('btn-log').addEventListener('click', () => {
                logModal.classList.remove('hidden');
                logModal.classList.add('flex');
                renderDiscoveryLog();
            });
            document.getElementById('log-close').addEventListener('click', () => {
                logModal.classList.add('hidden');
                logModal.classList.remove('flex');
            });
        }

        function updateLogBadge() {
            document.getElementById('log-badge').textContent = discoveryLog.length;
        }

        function renderDiscoveryLog() {
            const container = document.getElementById('log-items-container');
            container.innerHTML = '';

            if (discoveryLog.length === 0) {
                container.innerHTML = `<div class="text-center py-8 text-slate-400 text-xs"><i class="fa-solid fa-book-open text-2xl mb-2 text-cyan-500/50 block"></i>No planets explored yet. Select planets and click "Collect Fact" to add to your log!</div>`;
                return;
            }

            discoveryLog.forEach(item => {
                const div = document.createElement('div');
                div.className = 'glass-panel p-3.5 rounded-xl border border-cyan-500/20 text-xs';
                div.innerHTML = `
                    <div class="flex items-center justify-between mb-1">
                        <strong class="font-orbitron text-cyan-300 text-sm">${item.name}</strong>
                        <span class="text-[10px] text-slate-400">${item.date}</span>
                    </div>
                    <p class="text-slate-300">${item.fact}</p>
                `;
                container.appendChild(div);
            });
        }

        function showNotification(msg) {
            const notif = document.createElement('div');
            notif.className = 'fixed top-20 left-1/2 -translate-x-1/2 z-50 glass-panel px-4 py-2.5 rounded-xl border border-cyan-400 text-cyan-200 text-xs font-semibold shadow-xl transition-all duration-300';
            notif.innerHTML = `<i class="fa-solid fa-circle-check text-cyan-400 mr-2"></i> ${msg}`;
            document.body.appendChild(notif);
            setTimeout(() => {
                notif.style.opacity = '0';
                setTimeout(() => notif.remove(), 300);
            }, 2500);
        }

        window.onload = init;
    </script>
</body>
</html>
