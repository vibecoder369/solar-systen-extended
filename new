                        <span>Orbit Speed</span>
                        <span id="speed-val">1.0x</span>
                    </div>
                    <input id="range-speed" type="range" min="0" max="5" step="0.1" value="1" class="w-full accent-cyan-400 cursor-pointer">
                </div>
                <div class="flex items-center justify-between pt-2 border-t border-slate-700/60">
                    <span class="text-slate-300">Orbits Visible</span>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input id="toggle-orbits" type="checkbox" checked class="sr-only peer">
                        <div class="w-9 h-5 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-cyan-500"></div>
                    </label>
                </div>
                <div class="flex items-center justify-between pt-1">
                    <span class="text-slate-300">Rotation</span>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input id="toggle-rotation" type="checkbox" checked class="sr-only peer">
