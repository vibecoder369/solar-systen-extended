                <button id="tour-next" class="glass-button px-4 py-2 rounded-xl text-xs font-semibold text-cyan-300 flex items-center gap-2">
                    Next <i class="fa-solid fa-arrow-right"></i>
                </button>
            </div>
        </div>
    </div>

    <div id="quiz-modal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md hidden items-center justify-center p-4">
