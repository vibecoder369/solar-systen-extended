            </div>

            <div id="quiz-footer" class="flex items-center justify-between pt-4 border-t border-slate-800 text-xs text-slate-400">
                <span>Score: <strong id="quiz-current-score" class="text-cyan-300">0</strong></span>
                <button id="quiz-next-btn" class="glass-button px-4 py-2 rounded-xl text-xs font-semibold text-cyan-300 hidden">
                    Next Question <i class="fa-solid fa-arrow-right"></i>
                </button>
            </div>
        </div>
    </div>

    <div id="log-modal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md hidden items-center justify-center p-4">
        <div class="glass-panel w-full max-w-xl rounded-3xl p-6 shadow-2xl relative border border-cyan-500/40">
            <div class="flex items-center justify-between mb-4 pb-3 border-b border-cyan-500/30">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-indigo-500/20 flex items-center justify-center text-indigo-400">
                        <i class="fa-solid fa-book-bookmark"></i>
                    </div>
                    <div>
                        <h3 class="font-orbitron font-bold text-lg text-white">Discovery Log</h3>
