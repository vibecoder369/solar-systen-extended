    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;800;900&family=Rajdhani:wght@400;600;700&display=swap');
        body {
            font-family: 'Rajdhani', sans-serif;
            background-color: #020617;
            color: #f8fafc;
            overflow: hidden;
            margin: 0;
        }
        h1, h2, h3, .font-orbitron {
            font-family: 'Orbitron', sans-serif;
        }
        .glass-panel {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(56, 189, 248, 0.2);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }
        .glass-button {
            background: linear-gradient(135deg, rgba(30, 41, 59, 0.8), rgba(15, 23, 42, 0.9));
            border: 1px solid rgba(56, 189, 248, 0.4);
            transition: all 0.3s ease;
        }
        .glass-button:hover {
            background: linear-gradient(135deg, rgba(56, 189, 248, 0.3), rgba(30, 41, 59, 0.9));
            border-color: rgba(56, 189, 248, 0.8);
            box-shadow: 0 0 15px rgba(56, 189, 248, 0.4);
        }
        #canvas-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: 0;
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.5);
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(56, 189, 248, 0.5);
            border-radius: 3px;
        }
        .pulse-glow {
            animation: pulseGlow 3s infinite;
        }
        @keyframes pulseGlow {
            0% { box-shadow: 0 0 10px rgba(56, 189, 248, 0.4); }
            50% { box-shadow: 0 0 25px rgba(56, 189, 248, 0.8); }
            100% { box-shadow: 0 0 10px rgba(56, 189, 248, 0.4); }
        }
    </style>
</head>
<body class="w-screen h-screen relative select-none">

    <div id="canvas-container"></div>

    <header class="absolute top-0 left-0 w-full z-20 flex items-center justify-between px-6 py-4 pointer-events-none">
        <div class="flex items-center gap-3 pointer-events-auto glass-panel px-4 py-2 rounded-xl">
            <div class="w-10 h-10 rounded-full bg-cyan-500/20 flex items-center justify-center border border-cyan-400/40 text-cyan-400 font-bold text-lg pulse-glow">
                <i class="fa-solid fa-globe"></i>
            </div>
            <div>
                <h1 class="font-orbitron font-extrabold text-lg tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-200 to-indigo-300">SOLAR EXPLORER VR</h1>
                <p class="text-xs text-cyan-300/70 tracking-widest uppercase">Journey Through Our Solar System</p>
            </div>
        </div>

        <div class="flex items-center gap-3 pointer-events-auto">
            <button id="btn-tour" class="glass-button px-4 py-2 rounded-xl text-sm font-semibold flex items-center gap-2 text-cyan-200">
                <i class="fa-solid fa-route"></i> <span class="hidden md:inline">Guided Tour</span>
            </button>
            <button id="btn-quiz" class="glass-button px-4 py-2 rounded-xl text-sm font-semibold flex items-center gap-2 text-sky-200">
                <i class="fa-solid fa-brain"></i> <span class="hidden md:inline">Quiz</span>
            </button>
            <button id="btn-log" class="glass-button px-4 py-2 rounded-xl text-sm font-semibold flex items-center gap-2 text-indigo-200">
                <i class="fa-solid fa-book-bookmark"></i> <span class="hidden md:inline">Discovery Log</span> <span id="log-badge" class="bg-cyan-500 text-slate-950 px-1.5 py-0.5 rounded-full text-xs font-bold">0</span>
            </button>
            <div id="vr-button-container"></div>
        </div>
    </header>

    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-20 pointer-events-auto max-w-[95vw] overflow-x-auto pb-2 custom-scrollbar">
        <div class="glass-panel px-4 py-3 rounded-2xl flex items-center gap-3 shadow-2xl">
            <button class="planet-nav-btn px-3 py-1.5 rounded-xl text-xs font-semibold glass-button flex items-center gap-2 text-yellow-300" data-planet="sun">
                <span class="w-3 h-3 rounded-full bg-yellow-400 inline-block"></span> Sun
            </button>
            <button class="planet-nav-btn px-3 py-1.5 rounded-xl text-xs font-semibold glass-button flex items-center gap-2 text-slate-300" data-planet="mercury">
                <span class="w-3 h-3 rounded-full bg-slate-400 inline-block"></span> Mercury
            </button>
            <button class="planet-nav-btn px-3 py-1.5 rounded-xl text-xs font-semibold glass-button flex items-center gap-2 text-amber-200" data-planet="venus">
                <span class="w-3 h-3 rounded-full bg-amber-300 inline-block"></span> Venus
            </button>
            <button class="planet-nav-btn px-3 py-1.5 rounded-xl text-xs font-semibold glass-button flex items-center gap-2 text-blue-400" data-planet="earth">
                <span class="w-3 h-3 rounded-full bg-blue-500 inline-block"></span> Earth
            </button>
            <button class="planet-nav-btn px-3 py-1.5 rounded-xl text-xs font-semibold glass-button flex items-center gap-2 text-red-400" data-planet="mars">
                <span class="w-3 h-3 rounded-full bg-red-500 inline-block"></span> Mars
            </button>
            <button class="planet-nav-btn px-3 py-1.5 rounded-xl text-xs font-semibold glass-button flex items-center gap-2 text-amber-600" data-planet="jupiter">
                <span class="w-3 h-3 rounded-full bg-amber-600 inline-block"></span> Jupiter
            </button>
            <button class="planet-nav-btn px-3 py-1.5 rounded-xl text-xs font-semibold glass-button flex items-center gap-2 text-yellow-200" data-planet="saturn">
                <span class="w-3 h-3 rounded-full bg-yellow-200 inline-block"></span> Saturn
            </button>
            <button class="planet-nav-btn px-3 py-1.5 rounded-xl text-xs font-semibold glass-button flex items-center gap-2 text-cyan-300" data-planet="uranus">
                <span class="w-3 h-3 rounded-full bg-cyan-400 inline-block"></span> Uranus
            </button>
            <button class="planet-nav-btn px-3 py-1.5 rounded-xl text-xs font-semibold glass-button flex items-center gap-2 text-blue-600" data-planet="neptune">
                <span class="w-3 h-3 rounded-full bg-blue-600 inline-block"></span> Neptune
            </button>
            <div class="h-6 w-[1px] bg-slate-700 mx-1"></div>
            <button id="btn-reset-cam" class="px-3 py-1.5 rounded-xl text-xs font-semibold glass-button flex items-center gap-2 text-cyan-300 whitespace-nowrap">
                <i class="fa-solid fa-house"></i> Solar System View
            </button>
        </div>
    </div>

