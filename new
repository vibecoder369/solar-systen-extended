                </div>
            </div>

            <div id="quiz-result-container" class="hidden text-center py-6">
                <div class="w-16 h-16 rounded-full bg-cyan-500/20 border border-cyan-400 text-cyan-300 flex items-center justify-center mx-auto mb-4 text-2xl">
